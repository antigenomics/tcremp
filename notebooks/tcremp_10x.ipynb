   "source": [
    "\n",
    "donor='donor1'\n",
    "metrics_dbscan[method][donor]={'TRA':{},'TRB':{},'TRA_TRB':{}}\n",
    "chain='TRA'\n",
    "for e in eps_list:\n",
    "    model = DBSCAN(eps=e, min_samples=2)\n",
    "    dbscan.clstr(chain,tcremp_dict[donor], label,model=model)\n",
    "\n",
    "\n",
    "    df = tcremp_dict[donor].annot[chain].merge(dbscan.clstr_labels[chain])\n",
